# Shared by the whole workspace: the Convex CLI reads it at the repo root,
# and both Vite apps read it via envDir pointing at the root.
# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

VITE_CONVEX_URL=

# Same as VITE_CONVEX_URL but ends in .site
VITE_CONVEX_SITE_URL=

# Your local site URL
SITE_URL=http://localhost:3000